#!/usr/bin/env bash
# Makes a narrated, music-timed screen recording from a project directory.
#
#   bin/demo <command> <project-dir> [args]
#
#   new <dir>            start a project from projects/example
#   show                 print the project with its defaults filled in
#   narrate [scene ...]  ElevenLabs narration -> build/audio, build/durations.json
#           --dry        silent clips of an estimated length (no API key)
#   beats                beats and downbeats of the music -> build/beats.json
#   plan                 scenes on the downbeats -> build/plan.json
#   record               record the scenes -> build/frames, build/record.log
#   assemble             mix and encode -> build/<name>.mp4
#   check                loudness of each narration window in the mix
#   splash               render the splash image -> build/<name>-splash.png
#   build                plan, record, assemble, check
#   all                  narrate, beats, build, splash
#   themes               list the themes in lib/themes
#   theme <name> [project]  preview a theme's cards and splash -> build/themes/<name>/
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
lib="$root/lib"

usage() { sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
cmd=${1:-}; [ -n "$cmd" ] || usage
shift
case $cmd in
  -h|--help|help) usage 0 ;;
  themes) exec node "$lib/theme-preview.mjs" --list ;;
  theme)  [ -n "${1:-}" ] || { echo "demo theme: which theme?" >&2; usage; }; exec node "$lib/theme-preview.mjs" "$@" ;;
esac
project=${1:-}; [ -n "$project" ] || { echo "demo $cmd: which project directory?" >&2; usage; }
shift

python=python3
beats_python=python3
[ -x "$root/.venv/bin/python" ] && beats_python="$root/.venv/bin/python"

run() { printf '\n==> %s\n' "$1"; shift; "$@"; }
# Runs a command with its output also in build/<name>.log; the previous log
# is kept as build/<name>.prev.log.
logged() {
  local name=$1; shift
  mkdir -p "$project/build"
  [ ! -f "$project/build/$name.log" ] || mv "$project/build/$name.log" "$project/build/$name.prev.log"
  "$@" 2>&1 | tee "$project/build/$name.log"
  return "${PIPESTATUS[0]}"
}

case $cmd in
  new)
    [ ! -e "$project" ] || { echo "$project already exists" >&2; exit 1; }
    cp -R "$root/projects/example" "$project"
    rm -rf "$project/build" "$project/.profile"
    echo "Made $project from projects/example. Edit $project/project.mjs."
    ;;
  show)     node "$lib/project.mjs" "$project" ;;
  narrate)  logged narrate "$python" "$lib/narrate.py" "$project" "$@" ;;
  beats)    logged beats "$beats_python" "$lib/beats.py" "$project" "$@" ;;
  plan)     logged plan "$python" "$lib/plan.py" "$project" "$@" ;;
  record)
    if [ -z "${DISPLAY:-}" ] && command -v xvfb-run >/dev/null; then
      logged record xvfb-run -a -s "-screen 0 1920x1080x24" node "$lib/record.mjs" "$project"
    else
      logged record node "$lib/record.mjs" "$project"
    fi
    ;;
  assemble) logged assemble "$python" "$lib/assemble.py" "$project" "$@" ;;
  check)    logged check "$python" "$lib/check_audio.py" "$project" "$@" ;;
  splash)   logged splash node "$lib/splash.mjs" "$project" "$@" ;;
  build)
    run "plan"     "$0" plan "$project"
    run "record"   "$0" record "$project"
    run "assemble" "$0" assemble "$project"
    run "check"    "$0" check "$project"
    ;;
  all)
    run "narrate"  "$0" narrate "$project" "$@"
    run "beats"    "$0" beats "$project"
    "$0" build "$project"
    run "splash"   "$0" splash "$project"
    ;;
  *) echo "demo: unknown command $cmd" >&2; usage ;;
esac
